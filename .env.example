# Supabase Public Client Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Secrets (Configured in Supabase Edge Functions Secrets)
# Never expose these in client-side bundles or repository commits.
# Set via: npx supabase secrets set GEMINI_API_KEY=...
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_TTS_MODEL=gemini-2.5-flash
# MYGURU_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
